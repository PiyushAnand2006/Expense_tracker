[TEMPLATE]
MONGO_URI=mongodb://localhost:27017/expense_tracker
JWT_SECRET=your_jwt_secret_key_here
PORT=5000
FRONTEND_URL=http://localhost:3000

# Email (optional). If SMTP_HOST/SMTP_PORT are not set, emails are logged to the
# console instead of sent (dev mode). Example values for Gmail below.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=ExpenseTracker <no-reply@expensetracker.local>
